# Primary metadata source — required.
# Get a v3 API key at https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=your_tmdb_v3_api_key_here

# --- ISP-fallback metadata (optional but recommended for Indian users) ---
# Some ISPs (notably Jio) block api.themoviedb.org. When that's detected at
# app start the app silently switches to Trakt + Fanart.tv + OMDb. Without
# these keys the fallback layer returns empty results and the app appears
# unusable to blocked users.

# Trakt — replaces TMDB for search, details, recommendations, trending.
# Create an app at https://trakt.tv/oauth/applications and copy the Client ID.
VITE_TRAKT_CLIENT_ID=your_trakt_client_id_here

# Fanart.tv — replaces TMDB image CDN for posters and backdrops.
# Get a personal API key at https://fanart.tv/get-an-api-key/
VITE_FANART_API_KEY=your_fanart_api_key_here

# OMDb — secondary poster fallback when Fanart has no match.
# Free key (1k/day) at https://www.omdbapi.com/apikey.aspx
VITE_OMDB_API_KEY=your_omdb_api_key_here
