# Primary metadata source — required.
# Get a v3 API key at https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=your_tmdb_v3_api_key_here

# --- ISP-block escape hatch #1: TMDB proxy (RECOMMENDED) ---
# Some ISPs (notably Jio) block *.themoviedb.org at the DNS/SNI level. The repo
# ships a proxy that runs on your own (not-blocked) domain and forwards TMDB
# traffic server-side. When a block is detected, all TMDB API + image requests
# reroute through it — full TMDB quality, no fallback keys needed.
#
# On Vercel: api/tmdb/[...path].js deploys automatically. Set the value below to
#   the SAME-ORIGIN path (works because the function shares the app's domain):
VITE_TMDB_PROXY=/api/tmdb
#   Alternatively, a Cloudflare Worker (proxy/worker.js) — then use its full URL:
#   VITE_TMDB_PROXY=https://mview-tmdb-proxy.<you>.workers.dev

# --- ISP-block escape hatch #2: fallback metadata (optional) ---
# Last resort if the proxy is also unreachable (or unset). The app switches to
# Trakt + Fanart.tv + OMDb. Without these keys the fallback returns empty
# results and a blocked user sees a blank app.

# Trakt — replaces TMDB for search, details, recommendations, trending.
# Create an app at https://trakt.tv/oauth/applications and copy the Client ID.
VITE_TRAKT_CLIENT_ID=your_trakt_client_id_here

# Fanart.tv — replaces TMDB image CDN for posters and backdrops.
# Get a personal API key at https://fanart.tv/get-an-api-key/
VITE_FANART_API_KEY=your_fanart_api_key_here

# OMDb — secondary poster fallback when Fanart has no match.
# Free key (1k/day) at https://www.omdbapi.com/apikey.aspx
VITE_OMDB_API_KEY=your_omdb_api_key_here
